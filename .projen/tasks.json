{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(npx -c \"node --print process.env.PATH\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "execArgs": [
            "git",
            "checkout",
            "-b",
            "scratch"
          ],
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "exec": "npm run compile --workspaces --if-present"
        }
      ]
    },
    "compile:fixtures": {
      "name": "compile:fixtures",
      "description": "Precompile integration fixture stacks; Pulumi cannot run TS 7 sources",
      "steps": [
        {
          "exec": "tsc -p test-integration/fixtures/tsconfig.json"
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "execArgs": [
            "node",
            ".projenrc.ts"
          ]
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "npm install"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "npm ci"
        }
      ]
    },
    "lint": {
      "name": "lint",
      "description": "Lint with oxlint, type-aware; warnings fail the build",
      "steps": [
        {
          "exec": "oxlint --type-aware --deny-warnings"
        }
      ]
    },
    "lint:fix": {
      "name": "lint:fix",
      "description": "Lint with oxlint and autofix what is fixable",
      "steps": [
        {
          "exec": "oxlint --type-aware --fix"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package"
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "exec": "vitest run --dir test"
        },
        {
          "exec": "npm run test --workspaces --if-present"
        },
        {
          "spawn": "typecheck"
        },
        {
          "spawn": "lint"
        }
      ]
    },
    "test:integration": {
      "name": "test:integration",
      "description": "Both integration tiers, as CI runs them. Needs GCP credentials.",
      "steps": [
        {
          "spawn": "test:integration:preview"
        },
        {
          "spawn": "test:integration:deploy"
        }
      ]
    },
    "test:integration:deploy": {
      "name": "test:integration:deploy",
      "description": "Integration tier B: deploys to the sandbox, asserts, destroys",
      "steps": [
        {
          "spawn": "compile:fixtures"
        },
        {
          "exec": "vitest run --dir test-integration/deploy",
          "receiveArgs": true
        }
      ]
    },
    "test:integration:preview": {
      "name": "test:integration:preview",
      "description": "Integration tier A: pulumi preview against the sandbox; creates nothing",
      "steps": [
        {
          "spawn": "compile:fixtures"
        },
        {
          "exec": "vitest run --dir test-integration/preview",
          "receiveArgs": true
        }
      ]
    },
    "typecheck": {
      "name": "typecheck",
      "description": "Typecheck the test tree; compile only covers src",
      "steps": [
        {
          "exec": "tsc --noEmit -p tsconfig.json"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watch & compile in the background",
      "steps": [
        {
          "execArgs": [
            "tsc",
            "--build",
            "-w"
          ]
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"npx projen\"."
}
