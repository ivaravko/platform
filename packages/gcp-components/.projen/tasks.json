{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(npx -c \"node --print process.env.PATH\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "execArgs": [
            "tsc",
            "--build"
          ]
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "exec": "npx projen default",
          "cwd": "../.."
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "npm install"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "npm ci"
        }
      ]
    },
    "lint": {
      "name": "lint",
      "description": "Lint with oxlint, type-aware; warnings fail the build",
      "steps": [
        {
          "exec": "oxlint --type-aware --deny-warnings"
        }
      ]
    },
    "lint:fix": {
      "name": "lint:fix",
      "description": "Lint with oxlint and autofix what is fixable",
      "steps": [
        {
          "exec": "oxlint --type-aware --fix"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "execArgs": [
            "mkdir",
            "-p",
            "dist/js"
          ]
        },
        {
          "execArgs": [
            "npm",
            "pack",
            "--pack-destination",
            "dist/js"
          ]
        }
      ]
    },
    "policy:install": {
      "name": "policy:install",
      "description": "Install the policy pack into .runway-policy/ so it can be run",
      "steps": [
        {
          "exec": "rm -rf .runway-policy && npm install --prefix .runway-policy --no-audit --no-fund --legacy-peer-deps --install-links . @pulumi/pulumi@3.259.0 @pulumi/policy@1.21.0 @pulumi/gcp@9.35.1 typescript@5.9.3"
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "exec": "vitest run",
          "receiveArgs": true
        },
        {
          "spawn": "typecheck"
        }
      ]
    },
    "typecheck": {
      "name": "typecheck",
      "description": "Typecheck the test tree; compile only covers src",
      "steps": [
        {
          "exec": "tsc --noEmit -p test/tsconfig.json"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watch & compile in the background",
      "steps": [
        {
          "execArgs": [
            "tsc",
            "--build",
            "-w"
          ]
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"npx projen\"."
}
